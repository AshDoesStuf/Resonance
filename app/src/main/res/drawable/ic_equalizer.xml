      android:name="barCenter"
      android:pivotX="12"
      android:pivotY="20"
      android:scaleY="1.0">
    <path
        android:fillColor="@color/accent"
        android:pathData="M14,20 L14,6 Q14,4 12,4 Q10,4 10,6 L10,20 Q10,20 12,20 Q14,20 14,20Z"/>
  </group>

  <!-- Right bar (medium) — pivots from bottom (y=20) -->
  <group
      android:name="barRight"
      android:pivotX="18"
      android:pivotY="20"
      android:scaleY="1.0">
    <path
        android:fillColor="@color/accent"
        android:pathData="M20,20 L20,11 Q20,9 18,9 Q16,9 16,11 L16,20 Q16,20 18,20 Q20,20 20,20Z"/>
  </group>

