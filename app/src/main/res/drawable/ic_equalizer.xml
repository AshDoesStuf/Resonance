<!-- Replace res/drawable/ic_equalizer.xml -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

  <!-- Left bar (short) — pivots from bottom (y=20) -->
