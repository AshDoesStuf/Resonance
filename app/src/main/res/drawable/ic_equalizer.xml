        android:fillColor="@color/accent"
        android:pathData="M8,20 L8,14 Q8,12 6,12 Q4,12 4,14 L4,20 Q4,20 6,20 Q8,20 8,20Z"/>
  </group>

  <!-- Center bar (tall) — pivots from bottom (y=20) -->
