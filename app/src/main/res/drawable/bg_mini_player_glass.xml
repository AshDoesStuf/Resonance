<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Frosted dark fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC1C2230" /> <!-- ~80% opacity bg_tertiary -->
            <corners android:radius="34dp" />
        </shape>
    </item>

    <!-- Subtle top-edge highlight (the "glass" shine) -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#18FFFFFF" />
            <corners android:radius="34dp" />
        </shape>
    </item>

    <!-- Border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#2AFFFFFF" /> <!-- ~16% white border -->
            <corners android:radius="34dp" />
        </shape>
    </item>

</layer-list>