<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Base dark fill -->
  <item>
    <shape android:shape="rectangle">
      <corners
          android:topLeftRadius="24dp"
          android:topRightRadius="24dp" />
      <solid android:color="@color/bg_card" />
    </shape>
  </item>
  <!-- Subtle light gradient overlay — sells the "glass" illusion -->
  <item>
    <shape android:shape="rectangle">
      <corners
          android:topLeftRadius="24dp"
          android:topRightRadius="24dp" />
      <gradient
          android:angle="270"
          android:endColor="@color/bg_primary"
          android:startColor="@color/bg_sheet"
          android:type="linear" />
    </shape>
  </item>
  <!-- Side and Top highlight border -->
  <item
      android:bottom="-1dp"
      android:left="-1dp"
      android:right="-1dp"
      android:top="0dp">
    <shape android:shape="rectangle">
      <corners
          android:topLeftRadius="24dp"
          android:topRightRadius="24dp" />
      <stroke
          android:width="1dp"
          android:color="#28FFFFFF" />
    </shape>
  </item>
</layer-list>