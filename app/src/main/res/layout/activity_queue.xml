<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/queueRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

  <!-- Header -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="64dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="8dp"
      android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:src="@drawable/arrow_back_24px"
        app:tint="@color/text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Queue"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvQueueCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text=""
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/btnClearQueue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:text="Clear"
        android:textColor="@color/accent_red"
        android:textSize="14sp" />

  </LinearLayout>

  <!-- Action icon strip -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:paddingBottom="12dp">

    <!-- Save queue as playlist -->
    <LinearLayout
        android:id="@+id/btnSaveQueueAsPlaylist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

      <ImageView
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:contentDescription="Save as playlist"
          android:src="@drawable/ic_playlist_add"
          app:tint="@color/text_primary" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:text="Save"
          android:textColor="@color/text_muted"
          android:textSize="12sp" />

    </LinearLayout>

    <!-- Append queue to playlist -->
    <LinearLayout
        android:id="@+id/btnAppendQueueToPlaylist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

      <ImageView
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:contentDescription="Append to playlist"
          android:src="@drawable/ic_playlist_play"
          app:tint="@color/text_primary" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:text="Append"
          android:textColor="@color/text_muted"
          android:textSize="12sp" />

    </LinearLayout>

    <!-- Temp session -->
    <LinearLayout
        android:id="@+id/btnTempSession"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

      <ImageView
          android:id="@+id/ivTempSessionIcon"
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:contentDescription="Temp session"
          android:src="@drawable/ic_timer"
          app:tint="@color/text_primary" />

      <TextView
          android:id="@+id/tvTempSessionLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:text="Temp"
          android:textColor="@color/text_muted"
          android:textSize="12sp" />

    </LinearLayout>

  </LinearLayout>

  <!-- Thin divider -->
  <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:background="@color/divider" />

  <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/rvQueue"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:clipToPadding="false"
      android:paddingBottom="24dp" />
</LinearLayout>