<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

  <me.ash.resonance.ui.AmbientGlowView
      android:id="@+id/ambientGlowView"
      android:layout_width="match_parent"
      android:layout_height="match_parent" />

  <LinearLayout
      android:id="@+id/contentLayout"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingStart="28dp"
      android:paddingTop="16dp"
      android:paddingEnd="28dp"
      android:paddingBottom="36dp">

    <!-- ── Top bar: back button + "Now Playing" label ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

      <ImageButton
          android:id="@+id/btnBack"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_keyboard_arrow_down"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:tint="@color/text_primary" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:letterSpacing="0.12"
          android:text="Now Playing"
          android:textColor="@color/text_primary"
          android:textSize="14sp"
          android:textStyle="bold"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent" />

      <ImageButton
          android:id="@+id/btnListeningParty"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_auto_awesome"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:tint="@color/accent" />

      <ImageButton
          android:id="@+id/btnRemotePlay"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_cast"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toStartOf="@id/btnListeningParty"
          app:layout_constraintTop_toTopOf="parent"
          app:tint="@color/text_secondary" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Album art (compact, centred) with Ambient Glow ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:clipChildren="false"
        android:clipToPadding="false">

      <androidx.cardview.widget.CardView
          android:id="@+id/cardNowAlbumArt"
          android:layout_width="180dp"
          android:layout_height="180dp"
          android:layout_gravity="center"
          app:cardBackgroundColor="@color/bg_secondary"
          app:cardCornerRadius="16dp"
          app:cardElevation="16dp">

        <ImageView
            android:id="@+id/ivNowAlbumArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_note_outlined" />

      </androidx.cardview.widget.CardView>

    </FrameLayout>

    <!-- ── Title + artist (directly below art, centred) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="vertical">

      <TextView
          android:id="@+id/tvNowTitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="marquee"
          android:focusable="true"
          android:focusableInTouchMode="true"
          android:gravity="center"
          android:marqueeRepeatLimit="marquee_forever"
          android:singleLine="true"
          android:text="Song Title"
          android:textColor="@color/text_primary"
          android:textSize="22sp"
          android:textStyle="bold" />

      <TextView
          android:id="@+id/tvNowArtist"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:gravity="center"
          android:text="Artist"
          android:textColor="@color/text_primary"
          android:textSize="14sp" />

    </LinearLayout>

    <!-- ── Spacer: pushes controls to the bottom ── -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action row: queue / favourite / add to playlist -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

      <ImageButton
          android:id="@+id/btnQueue"
          android:layout_width="0dp"
          android:layout_height="38dp"
          android:layout_weight="1"
          android:alpha="0.7"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/queue_music_24px"
          app:tint="@color/text_primary" />

      <ImageButton
          android:id="@+id/btnFavourite"
          android:layout_width="0dp"
          android:layout_height="38dp"
          android:layout_weight="1"
          android:alpha="0.7"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_heart_outline"
          app:tint="@color/text_primary" />

      <ImageButton
          android:id="@+id/btnAddToPlaylist"
          android:layout_width="0dp"
          android:layout_height="38dp"
          android:layout_weight="1"
          android:alpha="0.7"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_playlist_add"
          app:tint="@color/text_primary" />

    </LinearLayout>

    <!-- ── Glass pill: action row + seekbar + main controls ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_pill"
        android:backgroundTint="@color/bg_sheet"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

      <!-- Seekbar + times -->
      <SeekBar
          android:id="@+id/seekBar"
          android:layout_width="match_parent"
          android:layout_height="32dp"
          android:minHeight="32dp"
          android:paddingStart="12dp"
          android:paddingEnd="12dp"
          android:progressBackgroundTint="@color/border"
          android:progressTint="@color/text_primary"
          android:thumbTint="@color/text_primary" />

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:orientation="horizontal"
          android:paddingStart="10dp"
          android:paddingEnd="10dp">

        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

      </LinearLayout>

      <!-- Main controls: shuffle | prev | play | next | repeat -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:gravity="center_vertical"
          android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnShuffle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:alpha="0.4"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/shuffle_24px"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnPrevious"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_previous"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1.4"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_pause"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_next"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnRepeat"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:alpha="0.4"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/repeat_24px"
            app:tint="@color/text_primary" />

      </LinearLayout>

    </LinearLayout>

    <!-- Bluetooth Device with Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

      <ImageView
          android:id="@+id/ivBluetoothIcon"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:layout_marginEnd="6dp"
          android:alpha="0.7"
          android:src="@drawable/ic_bluetooth_connected"
          app:tint="@color/text_secondary" />

      <TextView
          android:id="@+id/tvBluetoothDevice"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:alpha="0.7"
          android:text="No Audio Device"
          android:textColor="@color/text_secondary"
          android:textSize="12sp" />

    </LinearLayout>

  </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>