<?xml version="1.0" encoding="utf-8"?><!--
  Single YouTube Music result row.

  [ thumbnail ]  Title
                 Artist · duration
                                    [⋮]
  A small red YT badge overlaps the bottom-right of the thumbnail.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">

  <!-- Thumbnail with YT badge overlay -->
  <FrameLayout
      android:layout_width="46dp"
      android:layout_height="46dp">

    <ImageView
        android:id="@+id/ivYtThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_note_outlined" />


    <ProgressBar
        android:id="@+id/pbDownload"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:visibility="gone" />

    <!-- Downloaded checkmark (visible when done) -->
    <ImageView
        android:id="@+id/ivDownloaded"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="top|end"
        android:layout_margin="3dp"
        android:src="@drawable/ic_check_circle"
        android:visibility="gone"
        app:tint="@color/accent" />

  </FrameLayout>

  <!-- Title + artist/duration -->
  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_weight="1"
      android:orientation="vertical">

    <TextView
        android:id="@+id/tvYtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvYtArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

  </LinearLayout>

  <!-- Duration -->
  <TextView
      android:id="@+id/tvYtDuration"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="4dp"
      android:textColor="@color/text_muted"
      android:textSize="11sp" />

  <!-- More menu -->
  <ImageButton
      android:id="@+id/btnYtMore"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:src="@drawable/ic_more_vert"
      app:tint="@color/text_secondary" />

</LinearLayout>