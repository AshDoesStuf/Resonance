<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_surface"
    android:orientation="vertical"
    android:paddingBottom="32dp">

  <!-- Drag handle -->
  <View
      android:layout_width="40dp"
      android:layout_height="4dp"
      android:layout_gravity="center_horizontal"
      android:layout_marginTop="10dp"
      android:layout_marginBottom="16dp"
      android:background="@drawable/drag_handle_24px" />

  <!-- Title -->
  <TextView
      android:id="@+id/tvConfirmTitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="24dp"
      android:paddingEnd="24dp"
      android:textColor="@color/text_primary"
      android:textSize="17sp"
      android:textStyle="bold" />

  <!-- Subtitle / message -->
  <TextView
      android:id="@+id/tvConfirmMessage"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="24dp"
      android:paddingEnd="24dp"
      android:paddingTop="6dp"
      android:paddingBottom="20dp"
      android:textColor="@color/text_muted"
      android:textSize="13sp" />

  <!-- Buttons row -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="20dp"
      android:layout_marginEnd="20dp"
      android:orientation="horizontal">

    <TextView
        android:id="@+id/btnConfirmCancel"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:background="@drawable/glass_pill"
        android:gravity="center"
        android:text="Cancel"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnConfirmDelete"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:background="@drawable/btn_danger_rounded"
        android:gravity="center"
        android:text="Delete"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

  </LinearLayout>

</LinearLayout>