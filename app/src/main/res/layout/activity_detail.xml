<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingTop="24dp"
      android:paddingBottom="36dp">

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

      <ImageButton
          android:id="@+id/btnBack"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_keyboard_arrow_down"
          app:tint="@color/text_primary" />

      <!-- Album art card — GONE by default, shown for albums -->
      <androidx.cardview.widget.CardView
          android:id="@+id/cardDetailAlbumArt"
          android:layout_width="56dp"
          android:layout_height="56dp"
          android:layout_marginEnd="14dp"
          android:visibility="gone"
          app:cardBackgroundColor="@color/bg_card"
          app:cardCornerRadius="10dp"
          app:cardElevation="4dp">

        <ImageView
            android:id="@+id/ivDetailAlbumArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_note_outlined" />

      </androidx.cardview.widget.CardView>

      <!-- Title / subtitle / count -->
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center_vertical"
          android:orientation="vertical">

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvDetailArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDetailCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

      </LinearLayout>

      <!-- Action buttons — all GONE by default -->

      <ImageButton
          android:id="@+id/btnSortPlaylist"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:contentDescription="Sort"
          android:src="@drawable/ic_sort"
          android:visibility="gone"
          app:tint="@color/text_primary" />

      <ImageButton
          android:id="@+id/btnShufflePlaylist"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:contentDescription="Shuffle"
          android:src="@drawable/shuffle_24px"
          android:visibility="gone"
          app:tint="@color/text_primary" />

      <ImageButton
          android:id="@+id/btnEditPlaylist"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:contentDescription="Rename"
          android:src="@drawable/ic_edit"
          android:visibility="gone"
          app:tint="@color/text_primary" />

      <ImageButton
          android:id="@+id/btnDeletePlaylist"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:contentDescription="Delete"
          android:src="@drawable/ic_delete"
          android:visibility="gone"
          app:tint="@color/text_primary" />

      <ImageButton
          android:id="@+id/btnDuplicatePlaylist"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:contentDescription="Duplicate"
          android:src="@drawable/ic_copy"
          android:visibility="gone"
          app:tint="@color/text_primary" />

      <ImageButton
          android:id="@+id/btnSuggest"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:contentDescription="Suggest"
          android:src="@drawable/ic_auto_awesome"
          android:visibility="gone"
          app:tint="@color/text_primary" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDetailSongs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false" />
  </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>