<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:paddingStart="16dp"
      android:paddingTop="24dp"
      android:paddingEnd="16dp">

    <!-- Header row -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

      <ImageButton
          android:id="@+id/btnBack"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_keyboard_arrow_down"
          app:tint="@color/text_primary" />

      <!-- Album art card -->
      <androidx.cardview.widget.CardView
          android:id="@+id/cardDetailAlbumArt"
          android:layout_width="56dp"
          android:layout_height="56dp"
          android:layout_marginStart="8dp"
          android:layout_marginEnd="12dp"
          android:visibility="gone"
          app:cardBackgroundColor="@color/bg_card"
          app:cardCornerRadius="12dp"
          app:cardElevation="0dp">

        <ImageView
            android:id="@+id/ivDetailAlbumArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note" />

      </androidx.cardview.widget.CardView>

      <!-- Title / subtitle / count -->
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center_vertical"
          android:orientation="vertical"
          android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDetailCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

      </LinearLayout>

      <ImageButton
          android:id="@+id/btnMore"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:contentDescription="More"
          android:src="@drawable/ic_more_vert"
          app:tint="@color/text_primary" />


    </LinearLayout>
    <!-- Primary Action Bar -->
    <LinearLayout
        android:id="@+id/layoutPrimaryActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

      <ImageButton
          android:id="@+id/btnShufflePlaylist"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:contentDescription="Shuffle"
          android:src="@drawable/shuffle_24px"
          app:tint="@color/text_primary" />

      <ImageButton
          android:id="@+id/btnAddSongs"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:contentDescription="Add songs"
          android:src="@drawable/ic_add"
          android:visibility="gone"
          app:tint="@color/text_primary" />

    </LinearLayout>

    <!-- Legacy/Secondary buttons (hidden, used via More menu) -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

      <ImageButton
          android:id="@+id/btnSortPlaylist"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />

      <ImageButton
          android:id="@+id/btnEditPlaylist"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />

      <ImageButton
          android:id="@+id/btnDeletePlaylist"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />

      <ImageButton
          android:id="@+id/btnDuplicatePlaylist"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />

      <ImageButton
          android:id="@+id/btnSuggest"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/divider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDetailSongs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp" />

  </LinearLayout>

  <include layout="@layout/mini_player" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
