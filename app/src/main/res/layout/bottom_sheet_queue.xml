<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_surface"
    android:orientation="vertical">

  <!-- Drag handle pill -->
  <View
      android:layout_width="40dp"
      android:layout_height="4dp"
      android:layout_gravity="center_horizontal"
      android:layout_marginTop="10dp"
      android:layout_marginBottom="4dp"
      android:background="@drawable/drag_handle_24px" />

  <!-- Header -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="52dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="20dp"
      android:paddingEnd="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Queue"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvQueueCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text=""
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/btnClearQueue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:text="Clear"
        android:textColor="@color/accent_red"
        android:textSize="13sp" />

  </LinearLayout>

  <!-- Action icon strip -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:paddingBottom="10dp">

    <!-- Save queue as playlist -->
    <LinearLayout
        android:id="@+id/btnSaveQueueAsPlaylist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

      <ImageView
          android:layout_width="26dp"
          android:layout_height="26dp"
          android:contentDescription="Save as playlist"
          android:src="@drawable/ic_playlist_add"
          app:tint="@color/text_primary" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:text="Save"
          android:textColor="@color/text_muted"
          android:textSize="11sp" />

    </LinearLayout>

    <!-- Append queue to playlist -->
    <LinearLayout
        android:id="@+id/btnAppendQueueToPlaylist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

      <ImageView
          android:layout_width="26dp"
          android:layout_height="26dp"
          android:contentDescription="Append to playlist"
          android:src="@drawable/ic_playlist_play"
          app:tint="@color/text_primary" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:text="Append"
          android:textColor="@color/text_muted"
          android:textSize="11sp" />

    </LinearLayout>

    <!-- Temp session -->
    <LinearLayout
        android:id="@+id/btnTempSession"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

      <ImageView
          android:id="@+id/ivTempSessionIcon"
          android:layout_width="26dp"
          android:layout_height="26dp"
          android:contentDescription="Temp session"
          android:src="@drawable/ic_timer"
          app:tint="@color/text_primary" />

      <TextView
          android:id="@+id/tvTempSessionLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:text="Temp"
          android:textColor="@color/text_muted"
          android:textSize="11sp" />

    </LinearLayout>

  </LinearLayout>

  <!-- Thin divider -->
  <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:background="@color/divider" />

  <!-- Thin divider -->
  <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:background="@color/divider" />

  <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/rvQueue"
      android:layout_width="match_parent"
      android:layout_height="420dp"
      android:clipToPadding="false"
      android:paddingBottom="24dp" />

</LinearLayout>